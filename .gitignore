# Byte-compiled / optimized / DLL files
__pycache__/
*.py[codz]

# external workspace folders (Windows symlinks to sibling repos)
.external/
external/
.scratchpad/

# Editor / IDE
# `.vscode/*` (not `.vscode/`) plus the `!extensions.txt` exception
# keeps the wcde-generated extensions list tracked for PR contributors
# (so they can rebuild the same VS Code workspace).  Do NOT collapse
# back to `.vscode/` -- a directory ignore makes children unreachable
# to `!` re-includes.  See release_notes/README.md step 9.
.vscode/*
!.vscode/extensions.txt
.vs/
.idea/

# Build outputs
build/
stage/

# Experiment side-effects (logs are tracked via the !data/*.log allow rule
# below; .err captures and one-off scratch files are not).
data/*.err

# Per-machine Claude Code state
.claude/settings.json
.claude/settings.local.json

# LaTeX intermediates (the main PDF lives in build/, promoted to stage/)
*.aux
*.bbl
*.blg
*.log
!data/*.log
*.out
*.toc
*.fls
*.fdb_latexmk
*.fdb_latexmk_*
*.synctex.gz

# Python virtual environments (used by the full-stack template; harmless here)
.venv
.venv*
env/
venv/
ENV/

# Test / coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# OS junk
.DS_Store
Thumbs.db
